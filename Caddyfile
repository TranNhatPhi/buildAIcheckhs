{$APP_DOMAIN} {
	reverse_proxy frontend:3000
}

{$API_DOMAIN} {
	# Webhook GitHub (push → tự deploy) — chạy dạng container "deploy-webhook" (xem
	# deploy-webhook.py + docker-compose.prod.yml), điều khiển Docker của host qua socket
	# mount thay vì chạy trực tiếp trên host (VM không cấp sudo cho tài khoản đang dùng).
	handle /_deploy-webhook {
		reverse_proxy deploy-webhook:9090
	}
	handle {
		reverse_proxy backend:8001 backend2:8001 {
			lb_policy round_robin
			# health check chủ động — bỏ qua replica đang unhealthy/đang khởi động thay vì
			# vẫn gửi request round-robin vào nó và trả lỗi cho người dùng.
			health_uri /health
			health_interval 10s
		}
	}
}

# phpMyAdmin: khoá bằng basic_auth trước khi tới được app thật — BẮT BUỘC giữ, vì phpMyAdmin
# tự động đăng nhập bằng root (PMA_USER/PMA_PASSWORD preset), không có form login riêng như
# MinIO — bỏ basic_auth ở đây là để hở toàn bộ database không cần mật khẩu.
{$DB_DOMAIN} {
	basic_auth {
		admin {$ADMIN_TOOLS_PASSWORD_HASH}
	}
	reverse_proxy phpmyadmin:80
}

# MinIO Console có login riêng của chính nó (MINIO_ROOT_USER/PASSWORD) nên không cần thêm
# basic_auth ở Caddy nữa — bỏ theo yêu cầu, vẫn an toàn vì không phải để hở hoàn toàn.
{$STORAGE_DOMAIN} {
	reverse_proxy minio:9001
}
