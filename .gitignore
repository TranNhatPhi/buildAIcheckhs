# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# bản copy không-ẩn-file của .env.prod để tiện upload qua SSH-in-browser (chứa secret thật)
env-*-upload.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app-specific
backend/.venv/
backend/**/__pycache__/
backend/uvicorn.log
backend/test_vi*.png
nextjs-dev.log
