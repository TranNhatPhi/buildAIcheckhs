[Unit]
Description=GitHub deploy webhook listener (auto git pull + deploy.sh on push)
After=network.target docker.service

[Service]
Type=simple
User=nhatphivt2005
WorkingDirectory=/home/nhatphivt2005/buildAIcheckhs
EnvironmentFile=/home/nhatphivt2005/buildAIcheckhs/.env.webhook
ExecStart=/usr/bin/python3 /home/nhatphivt2005/buildAIcheckhs/deploy-webhook.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
